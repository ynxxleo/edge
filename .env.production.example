# Template only. Set actual values securely on the host; never commit a real .env.
APP_NAME=EDGE
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://edgepremiums.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Configure the host's persistent database. These are intentionally blank.
DB_CONNECTION=mysql
DB_ENGINE=InnoDB
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=/path/to/provider-ca.pem
# For a single instance using SQLite, use DB_CONNECTION=sqlite and an absolute
# DB_DATABASE path on a persistent volume, outside replaceable Git releases.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# storage/ must persist between releases. If KYC uses another private volume:
# KYC_STORAGE_PATH=/absolute/path/to/shared/private/kyc

MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"
MAIL_FROM_ADDRESS=hello@edgepremiums.com
MAIL_FROM_NAME="${APP_NAME}"
STAKING_DEPOSIT_INSTRUCTIONS="Contact the platform administrator for verified payment instructions. Deposits require review."
